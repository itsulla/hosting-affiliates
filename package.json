{
  "name": "deployapp-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Editorial deployment guide and interactive hosting comparison for AI-built apps.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:css && npm run build:js && npm run validate",
    "build:css": "tailwindcss -i ./src/styles.css -o ./styles.css --minify",
    "build:js": "esbuild ./src/site.js --bundle --minify --target=es2020 --format=iife --outfile=./site.js",
    "validate": "node ./scripts/validate-site.mjs && html-validate index.html"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "html-validate": "^11.5.6",
    "tailwindcss": "3.4.17"
  }
}
